// The smoke fixture: two models, one Query field, one Promise and one custom @gqlScalar.
// test/cli.test.ts runs the CLI on it, typechecks the generated schema and executes a query.
{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2022"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true
  },
  "include": ["models/**/*.ts", "schema.ts", "query.ts"],
  "grats": {
    "graphqlSchema": "./schema.graphql",
    "tsSchema": "./schema.ts",
    "importModuleSpecifierEnding": ".ts",
    "schemaHeader": null,
    "tsSchemaHeader": null
  }
}
