{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // This package compiles the vendored Grats engine (src/upstream), which upstream wrote
    // for strictNullChecks + strictPropertyInitialization only. Making it pass the repo's
    // extra flags would need real edits to vendored code, so this package keeps upstream's
    // strictness. The other packages stay fully strict.
    "strict": false,
    "strictNullChecks": true,
    "strictPropertyInitialization": true,
    "noUncheckedIndexedAccess": false,
    "exactOptionalPropertyTypes": false,
    // The engine (src/upstream) imports TypeScript as `#typescript` and keeps typechecking
    // against TypeScript 5.9.2's declarations, which the facade in src/ts/ implements on
    // TypeScript 7 at runtime (package.json `imports`). See src/ts/index.ts.
    "paths": {
      "#typescript": ["./node_modules/typescript-baseline/lib/typescript.d.ts"]
    }
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "scripts/**/*.ts", "*.ts"],
  "exclude": [
    "llm-docs/**",
    "test/fixtures/**",
    "test/integrationFixtures/**",
    "test/configParserFixtures/**"
  ]
}
