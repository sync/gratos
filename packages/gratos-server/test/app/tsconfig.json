// The M5 test app: Grats models whose generated schema the Effect layer runs (docs/plan.html M5
// "Done when": the generated strictSemanticNullability subscription, the async derived context,
// and the real wiring of the shutdown regression test). `pnpm codegen` regenerates
// src/generated/; `codegen:check` fails when it is stale.
{
  "compilerOptions": {
    "target": "esnext",
    "lib": ["esnext"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true
  },
  "include": ["src/**/*.ts"],
  "grats": {
    "graphqlSchema": "./src/generated/schema.graphql",
    "tsSchema": "./src/generated/schema.ts",
    "importModuleSpecifierEnding": ".ts",
    "strictSemanticNullability": true,
    "schemaHeader": null,
    "tsSchemaHeader": null
  }
}
