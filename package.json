{
  "name": "gratos",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "turbo run check",
    "codegen": "turbo run codegen",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "oxlint .",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "typecheck:root": "tsc -p tsconfig.json",
    "changeset": "changeset",
    "release": "node scripts/release.ts",
    "release:gate": "pnpm check && pnpm --filter @dblechoc/gratos vendor:verify",
    "release:publish": "changeset publish --from-pack-dir .pack",
    "release:test": "node scripts/install-test.ts .pack --peers min && node scripts/install-test.ts .pack --peers newest && node scripts/install-test.ts .pack --peers core"
  },
  "devDependencies": {
    "@changesets/changelog-github": "catalog:",
    "@changesets/cli": "catalog:",
    "@cloudflare/oxlint-config": "catalog:",
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "tsrs": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=26.13.0"
  },
  "packageManager": "pnpm@12.23.0"
}
