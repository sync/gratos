{
  "name": "orders-example",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/server.ts",
    "dev": "GRATS_DEV=1 node --watch-path=src/models --watch-path=src/services --watch-preserve-output src/server.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "codegen": "gratos --tsconfig src/tsconfig.json",
    "codegen:check": "gratos --check --tsconfig src/tsconfig.json",
    "bench:compiler": "node ../../packages/gratos/bench/run.ts --project src/tsconfig.json --baseline ../../bench/orders.json",
    "bench:subscriptions": "node bench/subscriptions.ts"
  },
  "dependencies": {
    "@dblechoc/gratos": "workspace:*",
    "@dblechoc/gratos-server": "workspace:*",
    "@effect/platform-node": "catalog:",
    "effect": "catalog:",
    "graphql": "catalog:"
  },
  "devDependencies": {
    "@apollo/client": "catalog:",
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "rxjs": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
