// The app's own tsconfig, which `gratos` and the dev boot step (`pnpm dev`) read: the models and
// services, with the `grats` key. It is self-contained (it extends nothing), so the dev-loop
// tests run a copy of src/ on its own. The package's tsconfig.json typechecks everything
// (src/, test/) under the repo's stricter base.
{
  "compilerOptions": {
    "target": "esnext",
    "lib": ["esnext"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true
  },
  "include": ["**/*.ts"],
  "exclude": ["generated/**"],
  "grats": {
    "graphqlSchema": "./generated/schema.graphql",
    "tsSchema": "./generated/schema.ts",
    "importModuleSpecifierEnding": ".ts",
    "strictSemanticNullability": true,
    "schemaHeader": null,
    "tsSchemaHeader": null
  }
}
